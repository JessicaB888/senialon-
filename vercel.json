{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "devCommand": "node ../scripts/dev-frontend.mjs",
      "functions": {
        "src/app/**/*": { "maxDuration": 60 }
      },
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "SENIALON_BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 60,
          "includeFiles": "senialon_api/generated/contract.json",
          "excludeFiles": "{tests/**,analysis/tests/**,scripts/**,migrate.py,.env*,.pytest_cache/**,README.md,VERIFICACION.md,analysis/README.md,analysis/verification.json}"
        }
      }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "frontend" } }]
}
