# Credencial compartida con Next. Sin valores predeterminados.
# Nunca usar NEXT_PUBLIC_ para estos nombres ni guardar valores en Git.
DEMO_USERNAME=
DEMO_PASSWORD=
# Origen exacto del navegador, sin path. HTTPS en despliegue.
# En local puede ser http://127.0.0.1:3000.
DEMO_ALLOWED_ORIGIN=

# Persistencia PostgreSQL del equipo. No hay migración automática al arrancar.
DATABASE_URL=

# Proveedores: claves privadas del servidor, nunca NEXT_PUBLIC_.
YOUTUBE_API_KEY=
TYPESAFE_API_KEY=
GEMINI_API_KEY=
JEV_MODEL=jev-latest
# Elegir un modelo verificado en la cuenta; no se presume uno disponible.
GEMINI_MODEL=
API_MODE=record

# Mantener false hasta verificar cuentas, tarifas, reservas y presupuesto.
PAID_CALLS_ENABLED=false
BUDGET_USD=20
JEV_RESERVATION_USD=
GEMINI_RESERVATION_USD=
PRICING_REFERENCE=
AVAILABLE_BALANCE_USD=
CONFIRMED_EXTERNAL_SPEND_USD=0
PROVIDER_TIMEOUT_SECONDS=15
