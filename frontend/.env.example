# FE 1.3 requiere los mismos valores de servidor que FastAPI.
# Sin configuración válida, el acceso permanece cerrado.
# Sin NEXT_PUBLIC_; nunca guardar secretos en el repositorio.
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_ALLOWED_ORIGIN=
# Vercel Services inyecta SENIALON_BACKEND_URL durante la ejecución.
# No configurar esa URL manualmente en la nube ni exponerla al navegador.
